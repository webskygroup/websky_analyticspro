{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="float-end"><a href="{{ export }}" class="btn btn-outline-secondary"><i class="fa-solid fa-download"></i> {{ button_export }}</a><button type="submit" form="form-analytics" class="btn btn-primary"><i class="fa-solid fa-save"></i></button><a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol></div></div>
  <div class="container-fluid">
    <div class="row g-3 mb-3">
      {% set cards = [['Visitors Today', summary.visitors|default(0), 'fa-users'], ['Sessions', summary.sessions|default(0), 'fa-layer-group'], ['New Users', summary.new_users|default(0), 'fa-user-plus'], ['Returning Users', summary.returning_users|default(0), 'fa-user-clock'], ['Orders', summary.orders|default(0), 'fa-bag-shopping'], ['Revenue', summary.revenue|default(0), 'fa-coins'], ['Conversion Rate', (summary.conversion_rate|default(0)) ~ '%', 'fa-percent'], ['Page Views', summary.page_views|default(0), 'fa-eye']] %}
      {% for card in cards %}<div class="col-xl-3 col-md-6"><div class="card shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-center"><div><div class="text-muted small">{{ card[0] }}</div><div class="fs-4 fw-bold">{{ card[1] }}</div></div><i class="fa-solid {{ card[2] }} fa-2x text-primary"></i></div></div></div>{% endfor %}
    </div>
    <div class="card mb-3"><div class="card-header"><i class="fa-solid fa-sliders"></i> {{ text_settings }}</div><div class="card-body"><form id="form-analytics" action="{{ save }}" method="post" data-oc-toggle="ajax"><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_measurement_id }}</label><div class="col-sm-9"><input type="text" name="analytics_analyticspro_measurement_id" value="{{ analytics_analyticspro_measurement_id }}" placeholder="G-XXXXXXXXXX" class="form-control"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_api_secret }}</label><div class="col-sm-9"><input type="password" name="analytics_analyticspro_api_secret" value="{{ analytics_analyticspro_api_secret }}" class="form-control" autocomplete="new-password"></div></div><div class="row mb-3"><label class="col-sm-3 col-form-label">{{ entry_status }}</label><div class="col-sm-9"><input type="hidden" name="analytics_analyticspro_status" value="0"><input type="checkbox" name="analytics_analyticspro_status" value="1" class="form-check-input"{% if analytics_analyticspro_status %} checked{% endif %}> {{ text_enabled }}</div></div><div class="row"><label class="col-sm-3 col-form-label">{{ entry_store_events }}</label><div class="col-sm-9"><input type="hidden" name="analytics_analyticspro_store_events" value="0"><input type="checkbox" name="analytics_analyticspro_store_events" value="1" class="form-check-input"{% if analytics_analyticspro_store_events %} checked{% endif %}> {{ text_store_events_help }}</div></div></form></div></div>
    <div class="row g-3"><div class="col-xl-6"><div class="card"><div class="card-header">{{ text_top_products }}</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>{{ column_product }}</th><th>{{ column_views }}</th><th>{{ column_cart_adds }}</th><th>{{ column_orders }}</th><th>{{ column_revenue }}</th></tr></thead><tbody>{% for row in products %}<tr><td>{{ row.name }}</td><td>{{ row.views }}</td><td>{{ row.cart_adds }}</td><td>{{ row.orders }}</td><td>{{ row.revenue }}</td></tr>{% else %}<tr><td colspan="5">{{ text_no_data }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card"><div class="card-header">{{ text_traffic_sources }}</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>{{ column_source }}</th><th>{{ column_medium }}</th><th>{{ column_sessions }}</th><th>{{ column_orders }}</th><th>{{ column_revenue }}</th></tr></thead><tbody>{% for row in sources %}<tr><td>{{ row.source }}</td><td>{{ row.medium }}</td><td>{{ row.sessions }}</td><td>{{ row.orders }}</td><td>{{ row.revenue }}</td></tr>{% else %}<tr><td colspan="5">{{ text_no_data }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card"><div class="card-header">{{ text_top_pages }}</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>{{ column_page }}</th><th>{{ column_views }}</th><th>{{ column_sessions }}</th></tr></thead><tbody>{% for row in pages %}<tr><td class="text-break">{{ row.page_title|default(row.page_url) }}</td><td>{{ row.views }}</td><td>{{ row.sessions }}</td></tr>{% else %}<tr><td colspan="3">{{ text_no_data }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card"><div class="card-header">{{ text_customer_journey }}</div><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>{{ column_visitor }}</th><th>{{ column_source }}</th><th>{{ column_pageviews }}</th><th>{{ column_cart_adds }}</th><th>{{ column_purchased }}</th></tr></thead><tbody>{% for row in journeys %}<tr><td>{{ row.visitor_id|slice(0,8) }}</td><td>{{ row.source }}</td><td>{{ row.pageviews }}</td><td>{{ row.cart_adds }}</td><td>{% if row.purchased %}{{ text_yes }}{% else %}{{ text_no }}{% endif %}</td></tr>{% else %}<tr><td colspan="5">{{ text_no_data }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
  </div>
</div>
{{ footer }}
